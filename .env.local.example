NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ログイン画面の文字リンクから利用する共有アカウント。NEXT_PUBLIC_を付けず、サーバーだけで保持する。
INSTITUTIONAL_SERVICE_DESK_EMAIL=
INSTITUTIONAL_SERVICE_DESK_PASSWORD=
INSTITUTIONAL_UNIVERSITY_STAFF_EMAIL=
INSTITUTIONAL_UNIVERSITY_STAFF_PASSWORD=

# 2アカウントで同じ共有パスワードを使う場合に設定可能。個別設定がある場合は個別設定を優先する。
INSTITUTIONAL_SHARED_PASSWORD=

# 関係者Authユーザーとプロフィールをログイン時に自動作成・修復するためのサーバー専用キー。
# Supabase Dashboard > Project Settings > API から取得し、VercelのProduction環境だけに設定する。
SUPABASE_SERVICE_ROLE_KEY=
